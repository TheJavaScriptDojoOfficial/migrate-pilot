{
  "name": "@migrate-pilot/desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Migrate Pilot desktop UI (React + Vite + TypeScript + Tauri).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
